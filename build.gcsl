import "github.com/gcslib/rust"
import "github.com/gcslib/clang"
import "github.com/peios/gxwi"
import "github.com/peios/peios-rs" as peios_rs
import build libauth from "github.com/peios/authd"

def crates() -> rust.RustWorkspace {
    = rust.workspace(dir("."), rust.vendored(file("Cargo.lock")), crates = kernel_settings())
}

# The vendored policy crates read shared semantic sources outside their own
# directories. Declare that tree for each isolated compilation.
def kernel_settings() -> List<rust.CrateSettings> {
    let kernel = [{at = "vendor/kernel"; place = dir("vendor/kernel")}]
    = for each in ["pnp-core", "peios-uapi"] { = {package = each; data = kernel} }
}

def build test_server() { = rust.bin(crates(), "radius-fixture", name = "radius-test-server") }

# Synthetic, bounded component qualification; no native authority or transport.
def build qualify() { = rust.bin(crates(), "radius-qualification", name = "radius-qualify") }

def native_crates(window: Bool = false) -> rust.RustWorkspace {
    let gui: List<rust.CrateSettings> = if window { gxwi.crate_settings() } else { [] }
    = rust.workspace(
        dir("."), rust.vendored(file("Cargo.lock")),
        crates = [
            ...kernel_settings(),
            ...peios_rs.crate_settings(),
            ...gui,
            {
                package = "radius-management"
                env = [{key = "LIBRARY_PATH"; value = "/opt/peios/lib"}]
                given = [
                    {at = "/opt/peios/lib/libauth.so"; place = build libauth()},
                    {at = "/opt/peios/lib/libauth.so.1"; place = build libauth()},
                ]
            },
        ],
        libclang = [clang.libclang_18()],
    )
}

def build radiusd() { = rust.bin(native_crates(), "radiusd", features = ["native"]) }

# Terminal administration without the optional desktop client library.
def build radius_cli() { = rust.bin(native_crates(), "radius", features = ["native"]) }

# The same program provides terminal administration and the GXWI window.
def build radius() { = rust.bin(native_crates(window = true), "radius", features = ["window"]) }
